{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meme-radar",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-20",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // The AVE plan's monthly credit allowance and the UTC day it resets. The
  // free plan's reset day is unverified; set it to your account's reset day.
  // Each chain's one RPC URL (an https JSON-RPC endpoint; empty disables it) serves
  // chain reads, such as Arc's new-pool discovery, and trading for users with a wallet. KYBER_CLIENT_ID is the x-client-id sent to the
  // KyberSwap Aggregator and is required once any chain is enabled. Explorer
  // URLs default to bscscan/basescan/etherscan; Arc has no default, so without
  // ARC_EXPLORER_URL an Arc transaction shows its hash only.
  // RUNTIME_DISABLED "1" freezes this deployment for the VPS cutover: webhook
  // updates are refused (Telegram keeps them), and no alarm or wake runs. Deploy
  // it with "crons": [] below as an uncommitted edit (docs/VPS-MIGRATION-PLAN.md,
  // "Data migration").
  "vars": {
    "RUNTIME_DISABLED": "0",
    "AVE_MONTHLY_CU": "1000000",
    "AVE_CU_RESET_DAY": "1",
    "KYBER_CLIENT_ID": "AlphaMeme",
    "ARC_RPC_URL": "https://rpc.mainnet.arc.io",
    "BSC_RPC_URL": "",
    "BASE_RPC_URL": "",
    "ETH_RPC_URL": "",
    "ARC_EXPLORER_URL": "",
    "BSC_EXPLORER_URL": "",
    "BASE_EXPLORER_URL": "",
    "ETH_EXPLORER_URL": ""
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RADAR",
        "class_name": "RadarAgent"
      },
      {
        "name": "TENANT_REGISTRY",
        "class_name": "TenantRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RadarAgent", "TenantRegistry"]
    }
  ]
  // Secrets are set out of band with `wrangler secret put`, never in this file:
  // OPERATOR_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_BOT_TOKEN, MASTER_ENC_KEY,
  // and optionally GOPLUS_APP_KEY with GOPLUS_APP_SECRET.
  // Each user's AVE API key is entered in Telegram with /setkey and stored encrypted.
}
