# The VPS host's environment, read by compose.yaml. Copy to .env, fill in, and
# keep it root-only (chmod 600). Names match the Worker's secrets and the vars
# in wrangler.jsonc; MASTER_ENC_KEY must be the Worker's exact value.

# Secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MASTER_ENC_KEY=
OPERATOR_TOKEN=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Vars (wrangler.jsonc values)
AVE_MONTHLY_CU=1000000
AVE_CU_RESET_DAY=1
KYBER_CLIENT_ID=AlphaMeme
ARC_RPC_URL=https://rpc.mainnet.arc.io
BSC_RPC_URL=
BASE_RPC_URL=
ETH_RPC_URL=
ARC_EXPLORER_URL=
BSC_EXPLORER_URL=
BASE_EXPLORER_URL=
ETH_EXPLORER_URL=
